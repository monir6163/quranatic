<header class="sticky top-0 z-40 border-b border-primary-900/10 bg-canvas/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3.5">
    <a href="#top" class="flex items-center gap-2.5">
      <% if (content.siteSettings.logo) { %>
        <img src="<%= content.siteSettings.logo %>" alt="<%= content.siteSettings.siteName %>" class="h-9 w-9 rounded-lg object-cover" />
      <% } else { %>
        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary-600 text-lg text-gold-100">﷽</span>
      <% } %>
      <span class="leading-tight">
        <span class="block font-display text-[15px] font-bold text-primary-800 sm:text-base"><%= content.siteSettings.siteName %></span>
        <span class="hidden text-[11px] text-ink/50 sm:block"><%= content.siteSettings.tagline %></span>
      </span>
    </a>

    <nav class="hidden items-center gap-6 text-sm font-semibold text-ink/70 md:flex">
      <a href="/#problems" class="transition hover:text-primary-700">সমস্যা</a>
      <a href="/#solution" class="transition hover:text-primary-700">সমাধান</a>
      <a href="/#faq" class="transition hover:text-primary-700">প্রশ্নোত্তর</a>
      <a href="/#testimonials" class="transition hover:text-primary-700">রিভিউ</a>
      <a href="/appointment" class="transition hover:text-primary-700">অ্যাপয়েন্টমেন্ট</a>
      <a href="/hand-appointment" class="transition hover:text-primary-700">হাতের ছবি</a>
    </nav>
    <div class="flex items-center gap-2.5">

      <a href="/appointment" class="inline-flex items-center justify-center rounded-full bg-primary-600 px-3.5 py-2 text-xs font-bold text-white shadow-md transition hover:bg-primary-700 sm:text-sm">
        অ্যাপয়েন্টমেন্ট
      </a>

      <a
  href="https://www.facebook.com/share/1BnchvNw64/"
  target="_blank"
  rel="noopener noreferrer"
  class="flex h-11 w-11 items-center justify-center rounded-full bg-[#1877F2] p-3 text-white shadow-md transition hover:bg-[#166FE5] hover:shadow-lg"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    class="h-6 w-6 fill-white"
    aria-hidden="true"
  >
    <path d="M22.675 0H1.325C.593 0 0 .593 0 1.326v21.348C0 23.407.593 24 1.325 24H12.82v-9.294H9.692V11.41h3.128V8.797c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.796.715-1.796 1.763v2.31h3.587l-.467 3.296h-3.12V24h6.116C23.407 24 24 23.407 24 22.674V1.326C24 .593 23.407 0 22.675 0z"/>
  </svg>
</a>
    </div>
  </div>
</header>
