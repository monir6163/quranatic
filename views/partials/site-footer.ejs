<footer class="bg-primary-800 pb-28 pt-14 text-primary-50 md:pb-14">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-2.5">
        <% if (content.siteSettings.logo) { %>
          <img src="<%= content.siteSettings.logo %>" alt="logo" class="h-9 w-9 rounded-lg object-cover" />
        <% } else { %>
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-gold-400 text-lg text-primary-900">﷽</span>
        <% } %>
        <span class="font-display text-lg font-bold"><%= content.siteSettings.siteName %></span>
      </div>
      <p class="mt-4 text-sm leading-relaxed text-primary-100/80"><%= content.footer.about %></p>
    </div>

    <div>
      <h4 class="font-display text-base font-bold text-gold-200">গুরুত্বপূর্ণ লিংক</h4>
      <ul class="mt-4 space-y-2 text-sm text-primary-100/80">
        <li><a href="/#problems" class="transition hover:text-gold-200">সমস্যা</a></li>
        <li><a href="/#solution" class="transition hover:text-gold-200">সমাধান</a></li>
        <li><a href="/#faq" class="transition hover:text-gold-200">প্রশ্নোত্তর</a></li>
        <li><a href="/#testimonials" class="transition hover:text-gold-200">গ্রাহক রিভিউ</a></li>
        <li><a href="/appointment" class="transition hover:text-gold-200">অ্যাপয়েন্টমেন্ট</a></li>
        <li><a href="/admin/login" class="transition hover:text-gold-200">অ্যাডমিন</a></li>
      </ul>
    </div>

    <div>
      <h4 class="font-display text-base font-bold text-gold-200">যোগাযোগ</h4>
      <ul class="mt-4 space-y-2 text-sm text-primary-100/80">
        <li>ফোন: <%= content.siteSettings.phone %></li>
        <li><%= content.footer.note %></li>
      </ul>
      <a href="<%= content.siteSettings.ctaLink %>" class="btn-primary mt-5 !bg-gold-400 !text-primary-900 hover:!bg-gold-300">
        <%= content.siteSettings.ctaText %>
      </a>
    </div>
  </div>

  <div class="mx-auto mt-10 max-w-6xl border-t border-primary-100/10 px-5 pt-6 text-center text-xs text-primary-100/60">
    &copy; <%= new Date().getFullYear() %> <%= content.siteSettings.siteName %> — <%= content.footer.copyrightText %>
  </div>
</footer>

