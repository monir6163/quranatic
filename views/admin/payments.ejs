<%- include('../partials/admin-layout-top', { active }) %>

<h1 class="font-display text-2xl font-bold text-primary-900">পেমেন্ট লেজার</h1>
<p class="mt-1 text-sm text-ink/60">অনলাইন পেমেন্ট গেটওয়ে (UddoktaPay) দিয়ে করা সব লেনদেনের রেকর্ড। এটি শুধু দেখার জন্য — পেমেন্ট যাচাই সার্ভার থেকে স্বয়ংক্রিয়ভাবে হয়।</p>

<%- include('../partials/admin-flash') %>

<% var g = typeof gateway !== 'undefined' ? gateway : { configured: false, mode: 'sandbox' }; %>
<div class="admin-card mt-6 flex flex-wrap items-center gap-3">
  <% if (g.configured) { %>
    <span class="rounded-full bg-primary-100 px-3 py-1 text-xs font-semibold text-primary-700">✓ গেটওয়ে কনফিগার করা আছে</span>
    <% if (g.mode === 'live') { %>
      <span class="rounded-full bg-clay/10 px-3 py-1 text-xs font-semibold text-clay ring-1 ring-clay/20">🔴 লাইভ মোড</span>
    <% } else { %>
      <span class="rounded-full bg-gold-50 px-3 py-1 text-xs font-semibold text-gold-600 ring-1 ring-gold-200">🧪 স্যান্ডবক্স (টেস্ট) মোড</span>
    <% } %>
  <% } else { %>
    <span class="rounded-full bg-clay/10 px-3 py-1 text-xs font-semibold text-clay ring-1 ring-clay/20">⚠ গেটওয়ে কনফিগার করা নেই — .env এ payment_base_url ও payment_api_key দিন</span>
  <% } %>
</div>

<form action="/admin/payments" method="GET" class="admin-card mt-6 flex flex-wrap items-end gap-3">
  <div class="min-w-[220px] flex-1">
    <label class="admin-label">মোবাইল / নাম / ইনভয়েস / ট্রানজেকশন দিয়ে সার্চ করুন</label>
    <input type="text" name="q" value="<%= q %>" placeholder="যেমন: 017 অথবা invoice id" class="admin-input" />
  </div>
  <button type="submit" class="admin-btn">সার্চ করুন</button>
  <% if (q) { %>
    <a href="/admin/payments" class="admin-btn !bg-primary-100 !text-primary-800 hover:!bg-primary-200">রিসেট</a>
  <% } %>
</form>

<div class="admin-card mt-6 overflow-x-auto p-0">
  <table class="w-full min-w-[960px] text-left text-sm">
    <thead>
      <tr class="border-b border-primary-900/10 bg-primary-50 text-xs font-bold uppercase tracking-wide text-primary-800">
        <th class="px-4 py-3">গ্রাহক</th>
        <th class="px-4 py-3">টার্গেট</th>
        <th class="px-4 py-3">পরিমাণ</th>
        <th class="px-4 py-3">মাধ্যম</th>
        <th class="px-4 py-3">স্ট্যাটাস</th>
        <th class="px-4 py-3">ইনভয়েস / ট্রানজেকশন</th>
        <th class="px-4 py-3">তারিখ</th>
      </tr>
    </thead>
    <tbody>
      <% if (!payments.length) { %>
      <tr>
        <td colspan="7" class="px-4 py-8 text-center text-ink/50">
          <% if (q) { %>
            "<%= q %>" দিয়ে কোনো পেমেন্ট পাওয়া যায়নি।
          <% } else { %>
            এখনো কোনো অনলাইন পেমেন্ট হয়নি।
          <% } %>
        </td>
      </tr>
      <% } %>
      <%
        var targetLabels = {
          HandAppointment: 'হাত অ্যাপয়েন্টমেন্ট',
          Appointment: 'অ্যাপয়েন্টমেন্ট',
          Order: 'অর্ডার'
        };
      %>
      <% payments.forEach(function(p){ %>
      <tr class="border-b border-primary-900/5 align-top hover:bg-primary-50/40">
        <td class="px-4 py-3">
          <div class="font-semibold text-ink"><%= p.fullName || '—' %></div>
          <div class="text-xs text-ink/55"><%= p.phone || '—' %></div>
        </td>
        <td class="px-4 py-3 whitespace-nowrap text-xs font-semibold text-ink/75">
          <%= targetLabels[p.targetType] || p.targetType %>
        </td>
        <td class="px-4 py-3 whitespace-nowrap text-xs text-ink/70">
          <div class="font-semibold text-ink/85">৳<%= p.amount %></div>
          <% if (p.gatewayAmount != null && Math.round(p.gatewayAmount) !== p.amount) { %>
            <div class="text-clay">গেটওয়ে: ৳<%= p.gatewayAmount %></div>
          <% } %>
        </td>
        <td class="px-4 py-3 text-xs text-ink/70">
          <div class="font-semibold text-ink/85"><%= p.paymentMethod || '—' %></div>
          <% if (p.senderNumber) { %><div><span class="text-ink/40">প্রেরক:</span> <%= p.senderNumber %></div><% } %>
        </td>
        <td class="px-4 py-3 whitespace-nowrap">
          <% if (p.status === 'COMPLETED') { %>
            <span class="rounded-full bg-primary-100 px-2.5 py-1 text-xs font-semibold text-primary-700">✓ সম্পন্ন</span>
          <% } else if (p.status === 'PENDING') { %>
            <span class="rounded-full bg-gold-50 px-2.5 py-1 text-xs font-semibold text-gold-600 ring-1 ring-gold-200">অপেক্ষমাণ</span>
          <% } else if (p.status === 'CANCELED') { %>
            <span class="rounded-full bg-ink/5 px-2.5 py-1 text-xs font-semibold text-ink/50 ring-1 ring-ink/10">বাতিল</span>
          <% } else { %>
            <span class="rounded-full bg-clay/10 px-2.5 py-1 text-xs font-semibold text-clay ring-1 ring-clay/20">ত্রুটি</span>
          <% } %>
        </td>
        <td class="px-4 py-3 text-xs text-ink/70">
          <div><span class="text-ink/40">Inv:</span> <%= p.invoiceId || '—' %></div>
          <div><span class="text-ink/40">Trx:</span> <%= p.transactionId || '—' %></div>
        </td>
        <td class="px-4 py-3 whitespace-nowrap text-xs text-ink/60">
          <%= new Date(p.createdAt).toLocaleDateString('bn-BD', { day: '2-digit', month: 'short', year: 'numeric' }) %><br />
          <%= new Date(p.createdAt).toLocaleTimeString('bn-BD', { hour: '2-digit', minute: '2-digit' }) %>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<%- include('../partials/admin-layout-bottom') %>
