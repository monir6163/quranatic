<%- include('../partials/admin-layout-top', { active }) %>

<h1 class="font-display text-2xl font-bold text-primary-900">গ্রাহক রিভিউ সেকশন</h1>
<p class="mt-1 text-sm text-ink/60">গ্রাহকদের রিভিউ যোগ/মুছুন/পরিবর্তন করুন।</p>

<%- include('../partials/admin-flash') %>

<form action="/admin/testimonials" method="POST" class="admin-card mt-6 max-w-3xl space-y-5">
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label class="admin-label">শিরোনাম</label>
      <input type="text" name="heading" value="<%= content.testimonials.heading %>" class="admin-input" />
    </div>
    <div>
      <label class="admin-label">সাব-শিরোনাম</label>
      <input type="text" name="subheading" value="<%= content.testimonials.subheading %>" class="admin-input" />
    </div>
  </div>

  <div id="rows" class="space-y-4">
    <% content.testimonials.items.forEach(function(item){ %>
    <div class="row grid gap-3 rounded-lg border border-primary-900/10 p-4 sm:grid-cols-[1fr_1.5fr_auto]">
      <div>
        <label class="admin-label">গ্রাহকের নাম</label>
        <input type="text" name="name[]" value="<%= item.name %>" class="admin-input" />
      </div>
      <div>
        <label class="admin-label">রিভিউ টেক্সট</label>
        <textarea name="text[]" rows="2" class="admin-input"><%= item.text %></textarea>
      </div>
      <div class="flex items-end">
        <button type="button" class="admin-btn-danger remove-row">মুছুন</button>
      </div>
    </div>
    <% }); %>
  </div>

  <button type="button" id="addRow" class="admin-btn !bg-primary-100 !text-primary-800 hover:!bg-primary-200">+ নতুন রিভিউ যোগ করুন</button>

  <div>
    <button type="submit" class="admin-btn">সংরক্ষণ করুন</button>
  </div>
</form>

<template id="rowTemplate">
  <div class="row grid gap-3 rounded-lg border border-primary-900/10 p-4 sm:grid-cols-[1fr_1.5fr_auto]">
    <div>
      <label class="admin-label">গ্রাহকের নাম</label>
      <input type="text" name="name[]" class="admin-input" />
    </div>
    <div>
      <label class="admin-label">রিভিউ টেক্সট</label>
      <textarea name="text[]" rows="2" class="admin-input"></textarea>
    </div>
    <div class="flex items-end">
      <button type="button" class="admin-btn-danger remove-row">মুছুন</button>
    </div>
  </div>
</template>

<script>
  document.getElementById('addRow').addEventListener('click', () => {
    const tpl = document.getElementById('rowTemplate');
    document.getElementById('rows').appendChild(tpl.content.cloneNode(true));
  });
  document.getElementById('rows').addEventListener('click', (e) => {
    if (e.target.classList.contains('remove-row')) {
      e.target.closest('.row').remove();
    }
  });
</script>

<%- include('../partials/admin-layout-bottom') %>
