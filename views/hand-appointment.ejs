<!DOCTYPE html>
<html lang="bn">
<head>
  <%- include('partials/head') %>
</head>
<body class="min-h-screen bg-canvas font-body text-ink">
  <%- include('partials/site-header') %>

  <main class="mx-auto max-w-3xl px-4 py-10 md:py-14">
    <div class="js-hand-wrap">

      <!-- Heading -->
      <div class="text-center">
        <h1 class="font-display text-2xl font-extrabold text-primary-900 sm:text-3xl"><%= page.title %></h1>
        <% if (page.description) { %>
        <p class="mx-auto mt-2 max-w-xl text-sm text-ink/60 whitespace-pre-line"><%= page.description %></p>
        <% } %>
      </div>

      <form
        class="js-hand-form mt-8 space-y-6"
        action="/api/hand-appointments"
        method="POST"
        enctype="multipart/form-data"
        data-payment-mode="<%= page.paymentMode %>"
        novalidate
      >
        <!-- Instructions -->
        <% if (page.instructions) { %>
        <section class="admin-card">
          <h2 class="mb-3 flex items-center gap-2 font-display text-lg font-bold text-primary-800">📋 নির্দেশনা</h2>
          <div class="rounded-lg border border-primary-900/10 bg-primary-50/60 p-4 text-sm leading-relaxed text-ink/75 whitespace-pre-line"><%= page.instructions %></div>
        </section>
        <% } %>

        <!-- Applicant info -->
        <section class="admin-card">
          <h2 class="mb-4 border-b border-primary-900/10 pb-2 font-display text-lg font-bold text-primary-800">আবেদনকারীর তথ্য</h2>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="hand-field" data-field="name">
              <label class="admin-label"><%= page.nameLabel %> <span class="text-clay">*</span></label>
              <input type="text" name="name" class="admin-input" placeholder="" />
              <p class="hand-error mt-1 hidden text-xs font-semibold text-clay"></p>
            </div>
            <div class="hand-field" data-field="phone">
              <label class="admin-label"><%= page.phoneLabel %> <span class="text-clay">*</span></label>
              <input type="tel" name="phone" maxlength="11" inputmode="numeric" class="admin-input" placeholder="" />
              <p class="hand-error mt-1 hidden text-xs font-semibold text-clay"></p>
            </div>
          </div>
        </section>

        <!-- Hand images -->
        <section class="admin-card">
          <h2 class="mb-4 border-b border-primary-900/10 pb-2 font-display text-lg font-bold text-primary-800">হাতের ছবি</h2>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <% var uploads = [ { field: 'rightHand', label: page.rightHandLabel }, { field: 'leftHand', label: page.leftHandLabel } ]; %>
            <% uploads.forEach(function(u){ %>
            <div class="hand-field" data-field="<%= u.field %>">
              <label class="admin-label"><%= u.label %> <span class="text-clay">*</span></label>
              <label class="js-hand-drop flex aspect-[4/3] cursor-pointer flex-col items-center justify-center gap-2 overflow-hidden rounded-lg border-2 border-dashed border-primary-900/20 bg-primary-50/40 text-center transition hover:border-primary-500 hover:bg-primary-50">
                <input type="file" name="<%= u.field %>" accept="image/*" class="js-hand-file hidden" />
                <img alt="" class="js-hand-preview hidden h-full w-full object-cover" />
                <span class="js-hand-placeholder flex flex-col items-center gap-1 px-3 py-6 text-sm text-ink/50">
                  <span class="text-2xl">🖐️</span>
                  <span>ছবি নির্বাচন করতে ক্লিক করুন</span>
                  <span class="text-xs text-ink/35">JPG / PNG / WEBP — সর্বোচ্চ ৫ MB</span>
                </span>
              </label>
              <p class="hand-error mt-1 hidden text-xs font-semibold text-clay"></p>
            </div>
            <% }); %>
          </div>
        </section>

        <!-- Payment -->
        <section class="admin-card">
          <h2 class="mb-4 border-b border-primary-900/10 pb-2 font-display text-lg font-bold text-primary-800">হাদিয়া ও পেমেন্ট</h2>

          <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl bg-primary-600 px-5 py-4 text-white">
            <span class="text-sm font-semibold opacity-90">প্রদেয় হাদিয়া</span>
            <span class="font-display text-2xl font-extrabold">৳<%= page.charge %></span>
          </div>

          <% if (page.paymentMode === 'gateway') { %>
          <div class="mt-4 rounded-lg border border-primary-200 bg-primary-50/70 p-4 text-sm leading-relaxed text-ink/80">
            <p class="flex items-center gap-2 font-semibold text-primary-800">🔒 নিরাপদ অনলাইন পেমেন্ট</p>
            <p class="mt-1 text-ink/70">আবেদন জমা দেওয়ার পর আপনি সরাসরি বিকাশ / নগদ / কার্ডের মাধ্যমে নিরাপদে হাদিয়া পরিশোধ করতে পারবেন। পেমেন্ট সম্পন্ন হলে আপনার আবেদনটি স্বয়ংক্রিয়ভাবে নিশ্চিত হবে ইনশাআল্লাহ।</p>
          </div>
          <% } else { %>
          <% if (page.paymentNumber || page.paymentInstructions) { %>
          <div class="mt-4 rounded-lg border border-gold-200 bg-gold-50 p-4 text-sm leading-relaxed text-ink/80">
            <% if (page.paymentNumber) { %>
            <p class="mb-1">
              <span class="font-semibold">সেন্ড মানি নম্বর:</span>
              <span class="select-all font-bold tracking-wide text-primary-800"><%= page.paymentNumber %></span>
            </p>
            <% } %>
            <% if (page.paymentInstructions) { %>
            <p class="whitespace-pre-line text-ink/70"><%= page.paymentInstructions %></p>
            <% } %>
          </div>
          <% } %>

          <div class="mt-4 grid grid-cols-1 gap-4">
            <% if (methods.length) { %>
            <div class="hand-field" data-field="paymentMethod">
              <label class="admin-label"><%= page.paymentMethodLabel %> <span class="text-clay">*</span></label>
              <div class="grid gap-2 sm:grid-cols-3">
                <% methods.forEach(function(m){ %>
                <label class="flex cursor-pointer items-center gap-2.5 rounded-lg border border-primary-900/15 px-4 py-2.5 text-sm font-medium transition has-[:checked]:border-primary-600 has-[:checked]:bg-primary-50 has-[:checked]:ring-2 has-[:checked]:ring-primary-500/30">
                  <input type="radio" name="paymentMethod" value="<%= m %>" class="accent-primary-600" />
                  <span><%= m %></span>
                </label>
                <% }); %>
              </div>
              <p class="hand-error mt-1 hidden text-xs font-semibold text-clay"></p>
            </div>
            <% } else { %>
            <div class="hand-field" data-field="paymentMethod">
              <label class="admin-label"><%= page.paymentMethodLabel %> <span class="text-clay">*</span></label>
              <input type="text" name="paymentMethod" class="admin-input" placeholder="যেমন: বিকাশ / নগদ" />
              <p class="hand-error mt-1 hidden text-xs font-semibold text-clay"></p>
            </div>
            <% } %>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div class="hand-field" data-field="transactionId">
                <label class="admin-label"><%= page.trxIdLabel %> <span class="text-clay">*</span></label>
                <input type="text" name="transactionId" class="admin-input" placeholder="যেমন: 8N7A2K1QX9" />
                <p class="hand-error mt-1 hidden text-xs font-semibold text-clay"></p>
              </div>
              <div class="hand-field" data-field="senderNumber">
                <label class="admin-label"><%= page.senderNumberLabel %> <span class="text-clay">*</span></label>
                <input type="tel" name="senderNumber" maxlength="11" inputmode="numeric" class="admin-input" placeholder="01XXXXXXXXX" />
                <p class="hand-error mt-1 hidden text-xs font-semibold text-clay"></p>
              </div>
            </div>
          </div>
          <% } %>
        </section>

        <p class="js-hand-submit-error hidden rounded-lg bg-red-50 px-4 py-3 text-sm font-semibold text-clay"></p>

        <button type="submit" class="js-hand-submit btn-primary w-full"><%= page.submitText %></button>
      </form>

      <div class="js-hand-success hidden rounded-xl2 bg-primary-50 p-8 text-center">
        <p class="font-display text-4xl">✅</p>
        <p class="mt-2 text-ink/80 whitespace-pre-line"><%= page.successMessage %></p>
        <a href="/" class="btn-primary mt-6">হোমপেজে ফিরুন</a>
      </div>

    </div>
  </main>

  <%- include('partials/site-footer') %>
  <script src="/js/hand-appointment.js"></script>
</body>
</html>
