PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/ruqyah_landing
SESSION_SECRET=please-change-this-to-a-long-random-string

# Used only once by `npm run seed` to create the first admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin+_+123

# UddoktaPay payment gateway (base URL already includes /api).
# Sandbox: https://sandbox.uddoktapay.com/api  |  Live: your paymently.io/api URL.
# The API key is used server-side only — never expose it to the browser.
payment_base_url=https://sandbox.uddoktapay.com/api
payment_api_key=your-uddoktapay-api-key

# Public base URL — used to build absolute redirect / cancel / webhook URLs for the gateway.
# Dev: http://localhost:3000 (the webhook needs a PUBLIC tunnel, e.g. ngrok).
# Prod: your real https domain.
PUBLIC_URL=http://localhost:3000
